# ── Tally Sync Service — Environment Configuration ────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in all values below (especially PG_PASSWORD and TALLY_COMPANIES)
# 3. Never commit .env to git — it contains your database password
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=production
LOG_LEVEL=info

# ── Tally Prime connection ────────────────────────────────────────────────────
# Since TallyPrime runs on the same VM as this service, use localhost.
TALLY_HOST=http://localhost
TALLY_PORT=9000

# XML request timeout in milliseconds.
# 120s is safe even for large Day Book exports (thousands of vouchers).
TALLY_TIMEOUT_MS=120000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Since PostgreSQL runs on the same VM as this service, use localhost.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=wallnut_sync
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_your_postgres_password

# ── Sync schedule ─────────────────────────────────────────────────────────────
# How often to run incremental voucher sync. 10 minutes is safe on 4 GB VM.
SYNC_INTERVAL_MINUTES=10

# Hour (0-23) to run the daily master sync (ledgers, stock items, outstanding).
# 2 = 2:00 AM, when no one is using Tally.
MASTER_SYNC_HOUR=2

# How many days to go back from the last successful sync on each run.
# This catches vouchers entered in Tally with a backdated date.
BACKFILL_DAYS=3

# ── Companies to sync ─────────────────────────────────────────────────────────
#
# FORMAT: displayName::tallyExactName::fiscalYearFrom::isHistorical
#   displayName    — Human-readable label stored in DB (can be anything)
#   tallyExactName — MUST EXACTLY match the company name in TallyPrime
#                    (go to TallyPrime → F1 Select Company → copy the name exactly)
#   fiscalYearFrom — FY start date used for the FIRST full sync (YYYY-MM-DD)
#   isHistorical   — true = sync ONCE then never again (for closed financial years)
#                    false = keep syncing incrementally
#
# Multiple companies: separate with pipe |
#
# EXAMPLE (two companies — FY 24-25 historical + FY 25-26 active):
# TALLY_COMPANIES=Wallnut 24-25::Wallnut Chemicals 24-25::2024-04-01::true|Wallnut 25-26::Wallnut Chemicals 25-26::2025-04-01::false
#
# EXAMPLE (single company, simpler):
# TALLY_COMPANIES=Wallnut 25-26::Wallnut Chemicals 25-26::2025-04-01::false
#
# Replace the example below with your actual Tally company names:
TALLY_COMPANIES=Company Display Name::Exact Tally Company Name::2025-04-01::false
